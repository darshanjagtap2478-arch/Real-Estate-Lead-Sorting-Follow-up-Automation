    {
      "parameters": {
        "jsCode": "// Keep only Hot leads whose alert is still Pending 15+ minutes after it fired,\n// and attach the fallback reason (Off-hours vs No-ack) to each one.\nconst FIFTEEN_MIN_MS = 15 * 60 * 1000;\nconst results = [];\n\nfor (const item of $input.all()) {\n  const row = item.json;\n  if (row['Status'] !== 'Hot') continue;\n  if (row['Response_Status'] !== 'Pending') continue;\n  if (!row['Timestamp']) continue;\n\n  const alertTime = new Date(row['Timestamp']);\n  const ageMs = Date.now() - alertTime.getTime();\n  if (isNaN(ageMs)) continue;           // unreadable timestamp - skip it instead of marking the lead as missed\n  if (ageMs < FIFTEEN_MIN_MS) continue; // not overdue yet — check again next sweep\n\n  // IST business hours check: Mon–Sat, 9:00–19:00\n  const istMs = alertTime.getTime() + (5.5 * 60 * 60 * 1000);\n  const ist = new Date(istMs);\n  const hour = ist.getUTCHours();\n  const day = ist.getUTCDay(); // 0 = Sunday\n  const isOffHours = day === 0 || hour < 9 || hour >= 19;\n\n  results.push({\n    json: {\n      ...row,\n      'Fallback_Reason': isOffHours ? 'Off-hours' : 'No-ack'\n    }\n  });\n}\n\nreturn results;"
      },
