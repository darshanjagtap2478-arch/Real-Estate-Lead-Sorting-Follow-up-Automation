      "parameters": {
        "jsCode": "// Projects people may book - keep this list the same as the dropdown in \"Render Booking Form\"\nconst ALLOWED_PROPERTIES = ['Project A', 'Project B', 'Project C'];\n\nconst rows = $('Get row(s) in sheet').all();\nif (!rows || rows.length === 0 || !rows[0].json['Lead ID']) {\n  throw new Error(\"Lead ID matching the booking token was not found in Master Leads database.\");\n}\nconst sheetData = rows[0].json;\nconst bookingData = $('Is POST Submission?').first().json.body || {};\n\nconst date = String(bookingData.preferred_date || '').trim(); // \"2026-07-11\"\nconst time = String(bookingData.preferred_time || '').trim(); // \"11:11\"\nconst propName = ALLOWED_PROPERTIES.includes(bookingData.property_name) ? bookingData.property_name : '';\n\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(date) || !/^\\d{2}:\\d{2}$/.test(time)) {\n  throw new Error(\"Form submission is missing a valid date or time.\");\n}\nif (!propName) {\n  throw new Error(\"Please select a valid project.\");\n}\n\n// 1. Explicitly force the start time into Indian Standard Time (+05:30)\nconst startTimeStr = date + 'T' + time + ':00+05:30';\nconst parsedStart = new Date(startTimeStr);\nif (isNaN(parsedStart.getTime())) {\n  throw new Error(\"The date or time is not valid.\");\n}\nif (parsedStart.getTime() < Date.now()) {\n  throw new Error(\"The chosen visit time is in the past.\");\n}\n\n// 2. Add exactly 1 hour for the end time\nconst parsedEnd = new Date(parsedStart.getTime() + 60 * 60 * 1000);\n\n// 3. Format the end time string back with the +05:30 offset\nconst offsetInMs = 5.5 * 60 * 60 * 1000;\nconst localEnd = new Date(parsedEnd.getTime() + offsetInMs);\nconst endTimeStr = localEnd.toISOString().slice(0, 19) + '+05:30';\n\nreturn [{\n  json: {\n    lead_id: sheetData['Lead ID'],\n    name: sheetData['Name'],\n    email: sheetData['Email'],\n    agent_email: sheetData['Agent Email'],\n    assigned_agent: sheetData['Assigned Agent'],\n    property_name: propName,\n    event_title: 'Site Visit: ' + propName + ' | ' + sheetData['Name'],\n    start_time: startTimeStr,\n    end_time: endTimeStr,\n    preferred_date: date,\n    preferred_time: time\n  }\n}];\n"
      },
