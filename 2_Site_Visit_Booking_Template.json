        "responseBody": "=<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Schedule Site Visit</title>\n  <style>\n    body { font-family: 'Segoe UI', sans-serif; background-color: #F7F5F0; color: #1A1816; margin: 0; padding: 50px 20px; display: flex; justify-content: center; }\n    .box { background-color: rgba(255, 255, 255, 0.6); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid rgba(0, 0, 0, 0.08); padding: 40px; border-radius: 6px; max-width: 500px; width: 100%; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04); }\n    h2 { font-size: 1.5rem; margin-bottom: 5px; }\n    p { color: #666666; font-size: 0.95rem; margin-bottom: 25px; }\n    label { display: block; font-weight: 600; font-size: 0.85rem; margin-top: 18px; margin-bottom: 6px; }\n    input, select { width: 100%; padding: 10px 14px; margin-bottom: 5px; border-radius: 4px; border: 1px solid rgba(0, 0, 0, 0.08); background-color: rgba(255, 255, 255, 0.8); color: #1A1816; font-size: 0.95rem; box-sizing: border-box; }\n    input:focus, select:focus { outline: none; border-color: #C5A059; }\n    select option { background-color: #F7F5F0; color: #1A1816; }\n    .btn { background-color: #C5A059; color: #FFFFFF; border: 1px solid #C5A059; padding: 12px 26px; border-radius: 4px; font-weight: 600; font-size: 0.95rem; cursor: pointer; width: 100%; margin-top: 20px; }\n    .btn:hover { background-color: #1A1816; border-color: #1A1816; }\n  </style>\n</head>\n<body>\n  <div class=\"box\">\n    <h2>📅 Select Visit Schedule</h2>\n    <p>Choose a date, time and project for your site visit.</p>\n    <form method=\"POST\" action=\"\">\n      <input type=\"hidden\" name=\"lead_id\" value=\"{{ $json.query.lead_id }}\">\n      <label for=\"preferred_date\">Preferred Date:</label>\n      <input type=\"date\" id=\"preferred_date\" name=\"preferred_date\" min=\"{{ new Date(Date.now() + 19800000).toISOString().slice(0, 10) }}\" required>\n      <label for=\"preferred_time\">Preferred Time:</label>\n      <input type=\"time\" id=\"preferred_time\" name=\"preferred_time\" required>\n      <label for=\"property_name\">Select Project Name:</label>\n      <select id=\"property_name\" name=\"property_name\">\n        <option value=\"Project A\">Project A</option>\n        <option value=\"Project B\">Project B</option>\n        <option value=\"Project C\">Project C</option>\n      </select>\n      <button type=\"submit\" class=\"btn\">Confirm Schedule</button>\n    </form>\n  </div>\n</body>\n</html>\n",
