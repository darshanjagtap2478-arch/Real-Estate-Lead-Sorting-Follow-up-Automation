  "name": "1. Lead Ingestion (Template)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-ingestion",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -896,
        288
      ],
      "id": "c5566938-ce6d-430e-b409-ccfe0c8e77c2",
      "name": "Webhook"
    },
    {
      "parameters": {
        "jsCode": "// ===================== SETTINGS - edit only these lines =====================\nconst BASE_URL = 'https://YOUR-N8N-DOMAIN';  // public URL of your n8n, no trailing slash\nconst AGENT_EMAIL = 'REPLACE_WITH_AGENT_EMAIL';               // receives the Hot/Warm alerts\nconst AGENT_NAME = 'Default Agent';                              // shown in the sheets and emails\n// ============================================================================\n\nlet lead = items[0].json;\nif (!lead.name && lead.body) { lead = lead.body; }\n\n// Remove < and > so nobody can put HTML into the emails, then trim spaces\nconst clean = (v) => (v === undefined || v === null ? '' : String(v)).replace(/[<>]/g, '').trim();\n\nconst name = clean(lead.name);\nconst email = clean(lead.email);\nconst phone = clean(lead.phone);\nconst location = clean(lead.location_pref);\nconst notes = clean(lead.notes);\nconst budgetMin = clean(lead.budget_min);\nconst budgetMax = clean(lead.budget_max);\n\nconst propertyTypes = ['Any', 'Apartment', 'Villa', 'Plot', 'Commercial'];\nconst propertyType = propertyTypes.includes(lead.property_type) ? lead.property_type : 'Any';\n\nconst sourceScores = { 'Website': 20, 'Landing Page': 20, 'Facebook': 10, 'Instagram': 10, 'Referral': 15, 'Google Ads': 15, 'Other': 5 };\nconst source = sourceScores[lead.source] ? lead.source : 'Other';\n\nconst phoneDigits = phone.replace(/\\D/g, '');\nconst emailOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\n\n// ---------- scoring (same rules as before) ----------\nlet score = 0;\nif (budgetMin && budgetMax) score += 20;\nelse if (budgetMin || budgetMax) score += 10;\n\nif (location.length > 2) score += 20;\nif (phoneDigits.length >= 10) score += 15;\nif (emailOk) score += 10;\nif (propertyType !== 'Any') score += 15;\nscore += sourceScores[source];\n\nconst urgencyWords = ['urgent', 'asap', 'immediate', 'tomorrow', 'this week', 'ready', 'serious', 'buy now', 'fast', 'quick'];\nif (notes) {\n  const notesLower = notes.toLowerCase();\n  if (urgencyWords.some(w => notesLower.includes(w))) score += 20;\n}\n\nscore = Math.min(100, Math.max(0, score));\n\nlet status = 'Cold';\nif (score >= 80) status = 'Hot';\nelse if (score >= 50) status = 'Warm';\n\n// timestamp + random suffix so IDs can't be guessed\nconst randomPart = Math.random().toString(36).substring(2, 8).toUpperCase().padEnd(6, '0');\nconst leadId = 'L' + Date.now() + randomPart;\n\n// ---------- validation ----------\nconst validationErrors = [];\nif (!name) validationErrors.push('Name is required');\nif (!emailOk) validationErrors.push('A valid email is required');\nif (phoneDigits.length < 10) validationErrors.push('A valid 10-digit phone number is required');\nconst isValidLead = validationErrors.length === 0;\n\nreturn [{\n  json: {\n    \"Lead ID\": leadId,\n    \"Valid\": isValidLead,\n    \"Validation Errors\": validationErrors.join('; '),\n    \"Name\": name || \"N/A\",\n    \"Email\": email,\n    \"Phone\": phone,\n    \"Location\": location || \"N/A\",\n    \"Budget Min\": budgetMin,\n    \"Budget Max\": budgetMax,\n    \"Property Type\": propertyType,\n    \"Source\": source,\n    \"Notes\": notes,\n    \"Score\": score,\n    \"Status\": status,\n    \"Timestamp\": new Date().toISOString(),\n    // the agent is set here on the server, NOT taken from the public form (stops anyone sending alerts to any address)\n    \"Assigned Agent\": AGENT_NAME,\n    \"Agent Email\": AGENT_EMAIL,\n    \"Booking Link\": BASE_URL + '/webhook/book-visit?lead_id=' + leadId\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -672,
        288
      ],
      "id": "564e16ed-b5a9-44b1-9d87-b09e89aed341",
      "name": "Code in JavaScript"
    },
